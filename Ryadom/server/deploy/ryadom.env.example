# Настройки сервера «Рядом». Лежат на сервере в /etc/ryadom/ryadom.env (права 600).

# Адрес сервера, как его видят телефоны (install.sh вписывает его сам).
PUBLIC_URL=https://ice-rust.store/ryadom

# Куда ведёт кнопка «Скачать «Рядом»» на странице приглашения.
# DOWNLOAD_URL=https://github.com/Makc960/Rust-plugins/releases/tag/ryadom

# Как связаться с автором — показывается в политике конфиденциальности.
# CONTACT=

# Обычно менять не нужно:
# DATA_DIR=/var/lib/ryadom
# PORT=8790
# HOST=127.0.0.1
