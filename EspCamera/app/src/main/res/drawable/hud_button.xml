<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_panel_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/hud_accent" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_panel" />
            <stroke
                android:width="1dp"
                android:color="#6639FF6A" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
