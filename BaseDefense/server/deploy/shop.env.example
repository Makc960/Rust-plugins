# Настройки сервера магазина «Обороны базы».
# Лежат на сервере в /etc/basedefense-shop/shop.env (права 600, читает только root и systemd).
# Токен сюда вписывает install.sh, сам не попадает ни в репозиторий, ни в игру.

# API-токен из кабинета Pally (раздел «Интеграция» / API). Никому не пересылайте.
PALLY_TOKEN=

# ID магазина (shop_id) из кабинета Pally.
PALLY_SHOP_ID=

# Адрес этого сервера, как его видит телефон игрока. Только https.
PUBLIC_URL=https://shop.example.ru

# Обычно менять не нужно:
# PALLY_API=https://pal24.pro/api/v1
# DATA_FILE=/var/lib/basedefense-shop/db.json
# PORT=8787
# HOST=127.0.0.1
