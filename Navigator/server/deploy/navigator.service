[Unit]
Description=Navigator server (road reports, shared drives, search notes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=navigator
Group=navigator
EnvironmentFile=/etc/navigator/navigator.env
ExecStart=/usr/bin/env node /opt/navigator/src/server.mjs
Restart=on-failure
RestartSec=3
# /var/lib/navigator: road reports, shared drives, search notes. The only place it may write.
StateDirectory=navigator
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
