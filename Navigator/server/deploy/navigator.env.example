# Настройки сервера «Навигатора». Лежат на сервере в /etc/navigator/navigator.env (права 600).
# После правки: systemctl restart navigator

# Адрес сервера, как его видят телефоны (install.sh вписывает его сам). Из него ссылки на поездки.
PUBLIC_URL=https://ice-rust.store/navigator

# Свои серверы поиска и маршрутов, когда они появятся: приложение возьмёт их отсюда само,
# без обновления. Пока пусто — приложение ходит на бесплатные общие серверы.
# PHOTON_URL=https://ice-rust.store/photon
# VALHALLA_URL=https://ice-rust.store/valhalla
# OSRM_URL=
# NOMINATIM_URL=
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Сообщение, которое приложение покажет всем один раз (например, «Вышла новая версия»).
# MESSAGE=
# Последняя версия приложения: у кого старее, тем предложат обновиться.
# LATEST_VERSION=1.3

# Как связаться с автором — показывается в политике конфиденциальности.
# CONTACT=

# Обычно менять не нужно:
# DATA_DIR=/var/lib/navigator
# PORT=8791
# HOST=127.0.0.1
